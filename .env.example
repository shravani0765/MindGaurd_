DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# --- Email (Brevo SMTP) ---------------------------------------------------
# Leave the console backend for local work; mail is printed to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery, switch to:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# Brevo dashboard -> SMTP & API -> SMTP. This is the "Login" value and looks
# like 9a1b2c001@smtp-brevo.com. It is NOT your Brevo account email.
EMAIL_HOST_USER=
# The "xsmtpsib-..." SMTP key from the same page. Never commit a real value.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=20
# Must be an address verified as a sender in Brevo, or delivery is rejected.
DEFAULT_FROM_EMAIL=
# Keep false so failed sends are logged and reported instead of swallowed.
EMAIL_FAIL_SILENTLY=false

# Demo only: mark new accounts verified immediately, so a deployment without
# working SMTP is still usable. Anyone can register any address while this is
# on — never enable it for real users.
DEMO_AUTO_VERIFY=false
# --- Gemini (companion replies) -------------------------------------------
# Server-side only. Do NOT use VITE_GEMINI_API_KEY in production: Vite inlines
# env vars into the JS bundle, so the key would be publicly readable.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

VITE_API_URL=http://127.0.0.1:8000/api
